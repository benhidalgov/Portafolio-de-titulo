        <!-- ===== CUADRO DE COSTOS ESTIMADOS ===== -->
        <mxCell id="costbox" value="Estimación de costos mensuales (referencial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="300" height="500" as="geometry" />
        </mxCell>
        <mxCell id="costtext" value="• Servidor pequeño en la nube&#10;   (aplicación + robot de búsqueda):&#10;   aprox. USD 10 – 25 / mes&#10;&#10;• Base de datos administrada&#10;   (plan básico): USD 0 – 15 / mes&#10;&#10;• Almacenamiento de archivos PDF&#10;   (por volumen bajo): USD 1 – 5 / mes&#10;&#10;• Consultas puntuales al modelo de&#10;   lenguaje para leer las bases&#10;   (solo cuando llega una licitación&#10;   nueva, no es un costo fijo):&#10;   USD 5 – 20 / mes según volumen&#10;&#10;• Envío de correos de alerta:&#10;   plan gratuito hasta cierto volumen&#10;&#10;• Dominio web: aprox. USD 1 / mes&#10;&#10;Total aproximado:&#10;USD 20 – 70 / mes&#10;(sin licencias caras ni servidores&#10;dedicados de alto costo)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="190" width="300" height="460" as="geometry" />
        </mxCell>

        <!-- ===== NOTA DE VIABILIDAD ===== -->
        <mxCell id="notabox" value="¿Por qué es viable para una empresa mediana?&#10;&#10;• No requiere comprar servidores propios: todo funciona con servicios pagados por uso (se paga solo lo que se consume).&#10;• El robot de búsqueda y el análisis de documentos usan herramientas gratuitas la mayor parte del tiempo; solo se paga una consulta a un modelo de lenguaje cuando realmente hace falta leer un documento complejo.&#10;• Se puede empezar en un plan básico y crecer solo si el volumen de licitaciones aumenta.&#10;• No exige instalar nada en los computadores del hotel: todo se usa desde el navegador." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#93c47d;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="1000" width="840" height="90" as="geometry" />
        </mxCell>

